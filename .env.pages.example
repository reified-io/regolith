# copy to .env beside compose.pages.yaml. every variable is described in docs/pages.md; a line
# commented out holds its default.

# compose only
REGOLITH_VERSION=0.5.0
#REGOLITH_REGISTRY=ghcr.io/reified-io
# 0.0.0.0:443 when this role terminates tls itself
REGOLITH_PAGES_PUBLISH=127.0.0.1:8081
# a private address the control plane reaches, or 0.0.0.0:8443 with the intake's own tls below
REGOLITH_PAGES_API_PUBLISH=127.0.0.1:8082
#REGOLITH_PAGES_CERT_DIR=./certs

# required: the domain sites are served under, as <site>.<domain>
REGOLITH_PAGES_DOMAIN=

# required: at least 32 characters, the same value the control plane publishes with. or
# REGOLITH_PAGES_TOKEN_FILE, a file holding it; set one, not both
REGOLITH_PAGES_TOKEN=
#REGOLITH_PAGES_TOKEN_FILE=

# listeners inside the container. the intake takes releases through its published port only with
# REGOLITH_PAGES_API_BIND=0.0.0.0
#REGOLITH_PAGES_BIND=0.0.0.0
#REGOLITH_PAGES_PORT=8081
#REGOLITH_PAGES_API_BIND=127.0.0.1
#REGOLITH_PAGES_API_PORT=8082

# what a site may hold
#REGOLITH_PAGES_MAX_FILES=2000
#REGOLITH_PAGES_MAX_FILE_MB=25
#REGOLITH_PAGES_MAX_SITE_MB=256
#REGOLITH_PAGES_RELEASES_KEPT=5
#REGOLITH_PAGES_MAX_SITES=200

# tls on the public listener, as pem files in REGOLITH_PAGES_CERT_DIR, which is mounted at
# /etc/regolith-pages/certs: such as /etc/regolith-pages/certs/origin.pem and origin.key. unset means
# plain http
#REGOLITH_PAGES_TLS_CERT=
#REGOLITH_PAGES_TLS_KEY=
# requires client certificates signed by this ca, such as a cdn's origin-pull ca
#REGOLITH_PAGES_TLS_CLIENT_CA=

# tls on the intake, so a control plane on another network publishes to an https address with the
# token: a certificate for the intake's own name. unset means plain http, for the same machine, a
# private network or a tunnel. a client ca only when a cdn sits in front of the intake too
#REGOLITH_PAGES_API_TLS_CERT=
#REGOLITH_PAGES_API_TLS_KEY=
#REGOLITH_PAGES_API_TLS_CLIENT_CA=

# memory, for a small machine: the jvm otherwise sizes its heap from the host's memory. with these
# flags the role holds about 140 mb serving tls with client certificates. not when the control plane
# runs from this same file, which would take them too:
# -Xmx64m -Xss512k -XX:MaxDirectMemorySize=32m -XX:MaxMetaspaceSize=64m -XX:ReservedCodeCacheSize=24m -XX:TieredStopAtLevel=1 -XX:+UseSerialGC
#JAVA_OPTS=

# serving. REGOLITH_PAGES_RESERVED adds labels nobody may publish, comma-separated, to www, api, mail,
# preview and the rest
#REGOLITH_PAGES_DIR=/var/lib/regolith-pages
#REGOLITH_PAGES_SCHEME=https
#REGOLITH_PAGES_RESERVED=
#REGOLITH_PAGES_CSP=frame-ancestors 'none'; form-action 'self'
