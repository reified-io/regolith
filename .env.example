# copy to .env beside compose.yaml. every variable is described in docs/configuration.md; a line
# commented out holds its default.

# compose only
REGOLITH_VERSION=0.5.0
#REGOLITH_REGISTRY=ghcr.io/reified-io
REGOLITH_PUBLISH=127.0.0.1:8080

# required: at least 32 characters, shared with every client. or REGOLITH_TOKEN_FILE, a file holding
# it; set one, not both
REGOLITH_TOKEN=
#REGOLITH_TOKEN_FILE=

# sandbox defaults and ceilings. the default image is what every sandbox that follows the server
# runs, from its next session on; one image per repository
#REGOLITH_SANDBOX_IMAGE=ghcr.io/reified-io/regolith-sandbox:0.5.0
#REGOLITH_ALLOWED_IMAGES=
#REGOLITH_NETWORK=public
#REGOLITH_CPUS=1
#REGOLITH_MEMORY_MB=1024
#REGOLITH_HOME_MB=4096
#REGOLITH_MAX_CPUS=2
#REGOLITH_MAX_MEMORY_MB=4096
#REGOLITH_MAX_HOME_MB=16384

# lifecycle
#REGOLITH_IDLE_STOP_SECONDS=900
#REGOLITH_MAX_SESSION_SECONDS=86400
#REGOLITH_RETAIN_DAYS=30
#REGOLITH_MAX_RETAIN_DAYS=90
#REGOLITH_UNATTENDED_CPU_SECONDS=600

# commands and transfers
#REGOLITH_EXEC_TIMEOUT_SECONDS=120
#REGOLITH_MAX_EXEC_TIMEOUT_SECONDS=3600
#REGOLITH_MAX_EXECS_PER_SANDBOX=8
#REGOLITH_MAX_FILE_MB=64
#REGOLITH_MAX_OUTPUT_MB=8

# publishing to the pages role, if this server has one: the address of its intake listener, such as
# http://10.0.0.5:8082, and its token or a file holding it. see docs/pages.md
#REGOLITH_PAGES_URL=
#REGOLITH_PAGES_TOKEN=
#REGOLITH_PAGES_TOKEN_FILE=

# host
#REGOLITH_HELPER_IMAGE=
#REGOLITH_MAX_SESSIONS=2
#REGOLITH_MIN_FREE_MB=2048
#REGOLITH_BLOCKED_CIDRS=
#REGOLITH_HOME_READ_BPS=100mb
#REGOLITH_HOME_WRITE_BPS=50mb
