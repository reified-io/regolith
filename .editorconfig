# the part of the code shape a formatter can hold; the rest is in AGENTS.md.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
# detekt refuses star imports, and the IDE folds them in on its own at five names.
ij_kotlin_name_count_to_use_star_import = 2147483647
ij_kotlin_name_count_to_use_star_import_for_members = 2147483647
ij_kotlin_packages_to_use_import_on_demand = unset
# the conventions encourage a trailing comma at the declaration site; this keeps the IDE from stripping one.
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
# one blank line separates, two are noise; and none is left hanging above a closing brace.
ij_kotlin_keep_blank_lines_in_declarations = 1
ij_kotlin_keep_blank_lines_in_code = 1
ij_kotlin_keep_blank_lines_before_right_brace = 0

[*.{yml,yaml}]
indent_size = 2
